# Market context provider mode
# Options: seeded | live
VITE_MARKET_DATA_PROVIDER=seeded

# Optional live provider API key
# Example: Alpha Vantage key for public market news
VITE_MARKET_DATA_API_KEY=
VITE_ALPHA_VANTAGE_API_KEY=

# Optional compatibility keys
NEXT_PUBLIC_MARKET_DATA_PROVIDER=
NEXT_PUBLIC_MARKET_DATA_API_KEY=
